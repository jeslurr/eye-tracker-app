VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# Gaze source: auto | python | webgazer
#   auto     - use the eye-tracking/ Python service if it's running, else WebGazer
#   python   - require the Python service (no silent fallback)
#   webgazer - in-browser only
VITE_GAZE_SOURCE=auto
VITE_GAZE_WS_URL=ws://127.0.0.1:8765
